# CtrlPay sandbox environment
# Copy to .env.local and fill in. NEVER commit .env.local.

# Google Gemini API key used by the live agent chat.
# The server calls the Gemini Interactions API directly and streams the answer
# to the AI SDK v4 browser client. Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override. Defaults to the current stable Flash model.
# Set GEMINI_MODEL=gemini-4-argon only if your key has paid access.
GEMINI_MODEL=gemini-3.8-flash

# Server secret used to sign proposals with HMAC-SHA256.
# Required in production. In the sandbox a non-secret dev fallback is used if unset.
CTRLPAY_SIGNING_SECRET=
