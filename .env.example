# CtrlPay sandbox environment
# Copy to .env.local and fill in. NEVER commit .env.local.

# Google Gemini API key used by the Vercel AI SDK v4 chat route.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model ID. Gemini 2.0 Flash was shut down on 1 June 2026.
# Keep a 2.5 model for AI SDK v4 tool calling (Gemini 3.x requires thought
# signatures that this SDK version does not preserve).
GEMINI_MODEL=gemini-2.5-flash

# Server secret used to sign proposals with HMAC-SHA256.
# Required in production. In the sandbox a non-secret dev fallback is used if unset.
CTRLPAY_SIGNING_SECRET=
