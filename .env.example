# CtrlPay sandbox environment
# Copy to .env.local and fill in. NEVER commit .env.local.

# Groq API key used by the live agent chat, OCR receipt check and payment advice.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional model override. Defaults to Groq's current production open-weight
# model with tool calling. Retired Llama 3.x overrides automatically fall back.
GROQ_MODEL=openai/gpt-oss-120b

# Server secret used to sign proposals with HMAC-SHA256.
# Required in production. In the sandbox a non-secret dev fallback is used if unset.
CTRLPAY_SIGNING_SECRET=
